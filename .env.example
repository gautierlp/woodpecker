# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat id (numeric)
TELEGRAM_CHAT_ID=
# Anthropic API key
ANTHROPIC_API_KEY=
# Vikunja API (task source of truth)
VIKUNJA_URL=https://tasks.example.com
VIKUNJA_TOKEN=
VIKUNJA_PROJECT_ID=
# Sidecar SQLite (Jolt's own nag state + display snapshot), defaults to data/sidecar.db.
# Relative to the container's WORKDIR (/app); ./data is bind-mounted to /app/data, so
# this is the value the running container actually uses (docker-compose.yml does not
# override it).
# Do not point this at data/jolt.db: that is the pre-Vikunja database kept for rollback,
# and its `tasks` table is not a sidecar schema. See docs/CUTOVER.md.
JOLT_DB_PATH=data/sidecar.db
# Log verbosity: INFO (default) or DEBUG (traces message bodies and Claude I/O)
JOLT_LOG_LEVEL=INFO
