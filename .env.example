# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat id (numeric)
TELEGRAM_CHAT_ID=
# Anthropic API key
ANTHROPIC_API_KEY=
# SQLite file path (defaults to data/jolt.db)
JOLT_DB_PATH=data/jolt.db
# Log verbosity: INFO (default) or DEBUG (traces message bodies and Claude I/O)
JOLT_LOG_LEVEL=INFO
